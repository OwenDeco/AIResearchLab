# This is a root-level convenience copy.
# The authoritative template is backend/.env.example — copy that to backend/.env.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
AZURE_OPENAI_API_KEY=YOUR_KEY_HERE
AZURE_OPENAI_ENDPOINT=https://YOUR-ENDPOINT-HERE
AZURE_OPENAI_DEPLOYMENT=gpt-4o
OLLAMA_BASE_URL=http://localhost:11434
DATABASE_URL=sqlite:///./ragtool.db
CHROMA_PERSIST_DIR=./chroma_data
GRAPH_DATA_PATH=./graph_data.json
DEFAULT_LLM=openai/gpt-4o-mini
DEFAULT_EMBED_MODEL=openai/text-embedding-3-small
AGENT_BASE_URL=http://localhost:8002
AGENT_MODEL=openai/gpt-4o
A2A_SYNTHESIZE=true
OS_DEBATE_ENDPOINT=https://harmonygroup-dev.outsystems.app/ONE2026/rest/OSAgent/StartDebate
OS_API_USERNAME=
OS_API_PASSWORD=
DEBUG=false
